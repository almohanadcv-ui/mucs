POSTGRES_DB=mab_task_allocator
POSTGRES_USER=mab_user
POSTGRES_PASSWORD=mab_password
DATABASE_URL=postgresql://mab_user@localhost:55432/mab_task_allocator
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
ATTACHMENTS_PATH=apps/api/data/attachments
API_UPSTREAM=http://localhost:4000
# Optional: enables the AI assistant for every authenticated user.
# Create a Gemini API key and set the same variable wherever the API service is hosted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CORS_ORIGINS=http://localhost:5173
# Public app URL — used to build deep links inside notification emails.
APP_URL=http://localhost:5173
# ── Email notifications (Microsoft Graph — reuse MICA / Evaluation Azure app) ──
# Copy GRAPH_* + MAIL_FROM verbatim from mica. Leave blank to disable all email.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=
MAIL_FROM_NAME=MAB Task Allocator
INITIAL_SUPERADMIN_NAME=J. Chehade
INITIAL_SUPERADMIN_USERNAME=j.chehade@mabunited.com
INITIAL_SUPERADMIN_PASSWORD=change-this-before-production
