# ── Database (own DB — isolated from every system) ──
DATABASE_URL="postgresql://user:pass@localhost:5432/mab_portal?schema=public"
DIRECT_URL="postgresql://user:pass@localhost:5432/mab_portal?schema=public"

# ── Portal ──
# Public URL of the portal itself (for links).
APP_URL="https://portal.mucs.online"
# Secret for portal session JWTs (long random string).
JWT_SECRET="change-me-to-a-very-long-random-string"
# Shared secret for the SSO handoff token each system's /sso endpoint verifies.
SSO_SECRET="change-me-to-another-long-random-string"

# ── Email (Microsoft Graph — same app registration as the other systems) ──
MAIL_PROVIDER="graph"
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
MAIL_FROM="it@mabunited.com"
MAIL_FROM_NAME="منصّة MAB"

# ── System base URLs (used to seed the launcher; editable later in DB) ──
SYS_EVALUATION_URL="https://eval.mucs.online"
SYS_GATEPASS_URL="https://getpass.mucs.online"
SYS_MICA_URL="https://mica.mucs.online"
SYS_TASKS_URL="https://tasks.mucs.online"
SYS_TICKETS_URL="https://support.mucs.online"

# First super-admin (IT) seeded on first run.
SEED_ADMIN_EMAIL="almuhannad.mahnashi@mabunited.com"
SEED_ADMIN_NAME="المهند المهنشي"

# ── المساعد الذكي (AI) — اختياري ──
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-haiku-4-5-20251001"

# ── سرّ مهمة المناسبات اليومية (تذكير أعياد الميلاد بالبريد) ──
CRON_SECRET=""

# فقط هذه الدومينات يُسمح لها بالدخول (مفصولة بفواصل)
ALLOWED_EMAIL_DOMAINS="mabunited.com"
