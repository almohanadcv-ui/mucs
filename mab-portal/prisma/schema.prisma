// ─────────────────────────────────────────────────────────────────────────────
// MAB Portal — a standalone unified launcher for all MAB systems.
// Isolated: its own database, its own identity. It never touches any existing
// system's database. It only decides who sees which system, and hands off a
// short-lived SSO token so each system can open its own session by email.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A portal identity — passwordless (email + emailed code). Separate from every
/// system's internal users; linked to them only by matching email at SSO time.
model PortalUser {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  name         String
  avatarUrl    String?
  isActive     Boolean @default(true)
  /// IT/super admin — sees every system regardless of explicit grants, and
  /// manages users + access from the portal admin panel.
  isSuperAdmin Boolean @default(false)
  /// Granted by IT — may post announcements and occasions (without full admin).
  canManageContent Boolean @default(false)
  /// Per-section permissions, toggled by IT. Off by default (least privilege);
  /// a super-admin bypasses all of these. Read fresh from the DB each request so
  /// IT changes take effect on the next page load without a re-login.
  canViewEmployees    Boolean @default(false)
  canViewOrg          Boolean @default(false)
  canSendNotifications Boolean @default(false)
  /// May use the Transactions module (create + sign correspondence).
  canUseTransactions  Boolean @default(false)
  /// Signing PIN (كلمة السر) hash — required to place a signature when set.
  signPinHash         String?

  // Org structure
  jobTitle     String?
  departmentId String?    @db.Uuid
  managerId    String?    @db.Uuid

  // Employee (HR) fields
  employeeNo     String?
  phone          String?
  nationalId     String?
  hireDate       DateTime?
  employmentType String? // دوام كامل | جزئي | عقد …
  workUnit       String? // وحدة العمل / الموقع الوظيفي
  location       String? // الموقع (المكتب الرئيسي…)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    PortalUser?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports    PortalUser[] @relation("ManagerReports")

  challenges    LoginChallenge[]
  sessions      RefreshToken[]
  access        UserSystemAccess[]
  notifications Notification[]
  tasks         Task[]
  heldAssets    Asset[]            @relation("AssetHolder")
  initiatedTransactions Transaction[]     @relation("TxInitiator")
  approvalSteps         TransactionStep[] @relation("TxApprover")
  signatures            UserSignature[]

  @@index([deletedAt])
  @@index([departmentId])
  @@index([managerId])
  @@map("portal_users")
}

/// A custody item / company asset (laptop, car, phone…) that can be assigned to
/// an employee. Every change is recorded in AssetLog.
model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  assetNo      String    @unique // A-86 …
  type         String    @default("OTHER") // LAPTOP | CAR | PHONE | OTHER
  nameAr       String
  nameEn       String?
  brand        String?
  serial       String?
  purchaseCost Float?
  purchaseDate DateTime?
  warrantyEnd  DateTime?
  location     String?
  note         String?
  /// AVAILABLE | ASSIGNED | DAMAGED | MAINTENANCE | ARCHIVED
  status       String    @default("AVAILABLE")
  assignedToId String?   @db.Uuid
  assignedAt   DateTime?
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo PortalUser? @relation("AssetHolder", fields: [assignedToId], references: [id], onDelete: SetNull)
  logs       AssetLog[]

  @@index([status])
  @@index([assignedToId])
  @@map("assets")
}

/// Full, literal history of an asset: who did what, when. Append-only.
model AssetLog {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @db.Uuid
  action    String // CREATE | ASSIGN | RETURN | UPDATE | STATUS | ARCHIVE
  actorId   String?  @db.Uuid
  actorName String?
  summary   String // human-readable line
  detail    Json? // structured before/after
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("asset_logs")
}

/// A department / section employees belong to.
model Department {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  createdAt DateTime     @default(now())
  users     PortalUser[]

  @@map("departments")
}

/// The catalogue of systems shown in the launcher. Static-ish reference data,
/// managed by IT. baseUrl + ssoPath are where the portal hands off to.
model System {
  id          String  @id @default(uuid()) @db.Uuid
  /// Stable machine key: "evaluation" | "gatepass" | "mica" | "tasks" | "tickets".
  key         String  @unique
  name        String
  nameEn      String?
  description String?
  /// lucide-react icon name, rendered in the sidebar.
  icon        String  @default("AppWindow")
  /// Accent color (hex) for the tile.
  color       String?
  /// Where the system lives (same domain, path or subdomain).
  baseUrl     String
  /// The SSO handoff path added to each system (e.g. "/sso"). Empty = link only.
  ssoPath     String  @default("/sso")
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links  SystemLink[]
  access UserSystemAccess[]

  @@map("systems")
}

/// A sub-link shown under a system when its tile is expanded (e.g. "الموظفون",
/// "التقارير"). Opened through the same SSO handoff with a `next` target.
model SystemLink {
  id       String  @id @default(uuid()) @db.Uuid
  systemId String  @db.Uuid
  label    String
  labelEn  String?
  /// Path within the system (relative to baseUrl), used as the SSO `next` target.
  path     String  @default("/")
  icon     String?
  order    Int     @default(0)

  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId, order])
  @@map("system_links")
}

/// Which portal user may see which system. Managed per-user by IT. A super admin
/// bypasses this table entirely.
model UserSystemAccess {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  systemId    String   @db.Uuid
  grantedById String?  @db.Uuid
  /// The user's role WITHIN this system (system-specific key, e.g. evaluation's
  /// EMPLOYEE|EVALUATOR|HR|MANAGEMENT|ADMIN). Null = the system's default.
  role        String?
  /// Per-user feature/section keys this user may see in the system (from the
  /// system's catalog). Empty = the role's default set (the system decides).
  features    String[] @default([])
  createdAt   DateTime @default(now())

  user   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  system System     @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([userId, systemId])
  @@index([userId])
  @@map("user_system_access")
}

/// Emailed six-digit sign-in code (passwordless). Only a hash is stored.
model LoginChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Company announcements shown on the portal home and optionally emailed to all.
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  body        String
  important   Boolean   @default(false)
  emailSent   Boolean   @default(false)
  /// Human-readable audience summary (الكل / أقسام: … / موظفون محددون).
  audience    String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([createdAt])
  @@map("announcements")
}

/// Per-user notification — shown in the bell and (optionally) emailed.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    @default("INFO") // INFO | ANNOUNCEMENT | EVENT | FEEDBACK | SYSTEM
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  emailSent Boolean   @default(false)
  createdAt DateTime  @default(now())

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// A personal task/calendar entry with a due time. When the time arrives the
/// client fires a browser notification + sound; `remindedAt` prevents repeats.
model Task {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  title      String
  note       String?
  dueAt      DateTime
  done       Boolean   @default(false)
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done, dueAt])
  @@map("tasks")
}

/// A dynamic approval transaction: a file that travels UP an ordered chain of
/// signers the initiator picked. Each step signs (approve) or rejects (returns
/// one step). When the last step signs, it completes and returns to the
/// initiator with every signature on the file. `version` guards against races.
model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  initiatorId  String   @db.Uuid
  /// Auto reference number shown to users (e.g. 4300041698).
  number       String?  @unique
  title        String   // الموضوع
  type         String?  // نوع المعاملة: خطاب | تعميم | …
  note         String?
  // Letter fields (البيانات)
  secrecy      String?  @default("عادي") // درجة السرية
  importance   String?  @default("عادي") // الأهمية
  content      String?  // محتوى الخطاب
  contentEnding String? // خاتمة محتوى الخطاب
  signerName   String?  // اسم صاحب التوقيع
  signerTitle  String?  // منصب صاحب التوقيع
  enclosures   String?  // المشفوعات
  internalCopies String? // نسخ داخلية
  prepEntity   String?  // جهة الإعداد
  approvalEntity String? // جهة صاحب الاعتماد
  recipients   Json?    // الجهات المرسل إليها: [{ name, ending }]
  /// DRAFT | IN_PROGRESS | COMPLETED | REJECTED | RETURNED | CANCELLED
  status       String   @default("IN_PROGRESS")
  /// Order index of the active step (0-based); equals step count when finished.
  currentStep  Int      @default(0)
  /// Optimistic-lock counter — every sign/reject bumps it inside a transaction.
  version      Int      @default(0)
  originalFile String?  // stored filename on disk (optional — a letter may have none)
  originalName String?  // display name
  mimeType     String?
  /// The final signed PDF (burned signatures) or the signatures certificate.
  signedFile   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  initiator PortalUser        @relation("TxInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  steps     TransactionStep[]

  @@index([initiatorId])
  @@index([status])
  @@map("transactions")
}

model TransactionStep {
  id            String    @id @default(uuid()) @db.Uuid
  transactionId String    @db.Uuid
  order         Int
  approverId    String    @db.Uuid
  /// PENDING | SIGNED | REJECTED | RETURNED
  status        String    @default("PENDING")
  /// التوجيه: للتوقيع | للاطلاع
  directive     String?   @default("للتوقيع")
  note          String?
  /// The drawn signature/stamp as a data URL (small PNG).
  signatureImg  String?
  actedAt       DateTime?
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  approver    PortalUser  @relation("TxApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([transactionId, order])
  @@index([approverId, status])
  @@map("transaction_steps")
}

/// A user's saved signature or stamp (drawn once, reused on transactions). The
/// owner's NAME is never stored here — it comes from their account at sign time.
model UserSignature {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String?
  kind      String   @default("SIGNATURE") // SIGNATURE | STAMP
  imageData String    // PNG data URL
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_signatures")
}

/// A suggestion or a complaint submitted from the top bar.
model Feedback {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String // SUGGESTION | COMPLAINT
  subject     String
  body        String
  status      String   @default("NEW") // NEW | SEEN | RESOLVED
  authorId    String?  @db.Uuid
  authorName  String?
  authorEmail String?
  createdAt   DateTime @default(now())

  @@index([kind, status])
  @@index([createdAt])
  @@map("feedback")
}

/// An occasion (birthday, work anniversary, event). A daily job emails the person
/// and posts a notification on their special day.
model Event {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @default("OCCASION") // BIRTHDAY | ANNIVERSARY | OCCASION
  title       String
  note        String?
  date        DateTime // the occasion date (year may be ignored for recurring)
  recurring   Boolean  @default(true) // repeats yearly (e.g. birthdays)
  personName  String?
  personEmail String?
  notifiedOn  String? // last YYYY-MM-DD an email was sent (prevents duplicates)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("events")
}

/// Append-only audit trail for the portal: who did what (created a user, granted
/// or revoked a system, signed in). Never deleted — the record of every change,
/// so nothing is silently lost and IT can review history.
model PortalAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorEmail String?
  action     String // CREATE_USER | GRANT_ACCESS | REVOKE_ACCESS | LOGIN | ...
  entityType String // "PortalUser" | "System" | "Access" | "Session"
  entityId   String?
  meta       Json? // extra detail (system key, granted list, …)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("portal_audit_logs")
}

/// Portal session (rotating refresh token; only a hash is stored).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  family    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}
