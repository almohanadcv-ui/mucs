# ── MICA API Test Lab — configuration ─────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. No IPs/credentials in code.

# Target API base URL (no trailing slash). Point at PRODUCTION for read-only
# smoke/baseline/GET-load only; point at STAGING for the heavy/write tests.
BASE_URL=https://mica.mucs.online

# Where the health check lives (relative to BASE_URL).
HEALTH_PATH=/health
READY_PATH=/health/ready

# Dedicated TEST account (least privilege that still exercises the flows).
TEST_EMAIL=
TEST_PASSWORD=

# Load shape (overridable per run). VUS = virtual users, DURATION = k6 duration.
VUS=5
DURATION=1m

# Environment guard. "production" blocks stress/spike/soak/write tests.
# Set to "staging" (and ALLOW_WRITE=1) to enable them.
TEST_ENV=production
ALLOW_WRITE=0

# ── Thresholds / PASS-FAIL (overridable) ──────────────────────────────────────
TH_P95_MS=800          # p95 must stay below this (ms) to PASS
TH_P99_MS=2000
TH_ERROR_RATE=0.01     # <1% errors to PASS

# ── Automatic ABORT conditions (monitor + k6) ─────────────────────────────────
ABORT_ERROR_RATE=0.05  # >5% errors → abort
ABORT_P95_MS=5000      # p95 > 5s sustained → abort
ABORT_CPU=95           # CPU% sustained → abort
ABORT_RAM=90           # RAM% → abort
ABORT_PG_CONN_PCT=90   # PG connections vs max_connections → abort
ABORT_SUSTAIN_SEC=15   # a condition must hold this long before aborting

# ── Server monitoring (used by monitoring/server-monitor.sh on the SERVER) ─────
# Postgres (read-only monitoring role recommended). Leave blank to skip PG stats.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=mica
# Redis (mica). Leave blank to skip Redis stats.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# BullMQ queue names to sample (space-separated). Discovered from source.
BULLMQ_QUEUES="email webhook-delivery"
# PM2 process name(s) to sample.
PM2_PROCS="mica-api"
