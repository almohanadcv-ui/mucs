// ─────────────────────────────────────────────────────────────────────────────
// EMS — Evaluation Management System
// Prisma schema. Multi-tenant ready, soft-delete everywhere, full audit trail.
// Conventions:
//   - UUID primary keys
//   - createdAt / updatedAt / deletedAt (soft delete) on all domain tables
//   - Every tenant-scoped row carries tenantId + composite indexes
//   - Enums are mirrored in src/core/domain/enums.ts (keep values in sync)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ────────────────────────────────────────

enum Role {
  ADMIN // IT — full control
  MANAGEMENT // الإدارة — oversees evaluations across the org
  HR // الموارد البشرية — leaves feedback notes on managers' evaluations (no approval)
  PRIMARY_REVIEWER // (legacy) المراجع الأساسي — retained for existing accounts
  SUPERVISOR // (legacy) المراجع — retained for existing accounts
  EVALUATOR // المقيّم / المدير — fills AND approves evaluations
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EvaluationStatus {
  DRAFT
  // ── New manager↔employee flow ──
  SENT_TO_EMPLOYEE // submitted; magic-link emailed to the employee; awaiting them
  EMPLOYEE_RESPONDED // employee replied/objected; back with the manager
  EMPLOYEE_ACKNOWLEDGED // employee agreed; manager may approve
  // ── Legacy (kept so existing rows stay valid; no longer produced) ──
  PENDING
  NEEDS_EDIT
  PRELIMINARY_APPROVED
  APPROVED // finally approved by the manager — locks + emails the employee
  REJECTED
}

enum TemplateKind {
  REGULAR // التقييم الاعتيادي
  PROBATION // تقييم فترة التجربة
}

enum CommentAuthor {
  MANAGER // المقيّم / المدير
  EMPLOYEE // الموظف (عبر الرابط السحري)
  HR // الموارد البشرية — ملاحظات داخلية على المدير
}

enum QuestionType {
  STAR_RATING
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
  TEXTAREA
  NUMBER
  DATE
  TIME
  YES_NO
  DROPDOWN
  FILE_UPLOAD
}

enum NotificationType {
  ASSIGNMENT
  APPROVAL
  REJECTION
  REMINDER
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  APPROVE
  REJECT
  EXPORT
}

// ───────────────────────────── Tenant ───────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users           User[]
  branches        Branch[]
  departments     Department[]
  employees       Employee[]
  customEmployees CustomEmployee[]
  templates       EvaluationTemplate[]
  evaluations     Evaluation[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([deletedAt])
  @@map("tenants")
}

// ───────────────────────────── Auth / Users ─────────────────────────────────

model User {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  email        String
  passwordHash String
  name         String
  role         Role
  avatarUrl    String?
  isActive     Boolean @default(true)

  emailVerifiedAt DateTime?

  // Brute-force / lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // 2FA (secret stored encrypted at rest — never plaintext)
  twoFactorEnabled       Boolean @default(false)
  twoFactorSecretEnc     String?
  twoFactorRecoveryCodes String? // encrypted JSON array of hashed codes

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  refreshTokens             RefreshToken[]
  loginChallenges           LoginChallenge[]
  passwordResetTokens       PasswordResetToken[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  // Domain links: a User (SUPERVISOR/EVALUATOR) maps to an Employee record via profile
  supervisedEmployees       Employee[]           @relation("SupervisorOf")
  evaluatedEmployees        Employee[]           @relation("EvaluatorOf")
  employeeProfile           Employee?            @relation("UserProfile")
  createdTemplates          EvaluationTemplate[] @relation("TemplateCreator")
  submittedEvaluations      Evaluation[]         @relation("EvaluationSubmitter")
  reviewedEvaluations       Evaluation[]         @relation("EvaluationReviewer")
  prelimReviewedEvaluations Evaluation[]         @relation("EvaluationPrelimReviewer")
  customEmployeesEvaluated  CustomEmployee[]     @relation("CustomEmployeeEvaluator")
  customEmployeesCreated    CustomEmployee[]     @relation("CustomEmployeeCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Only a hash of the token is stored; raw token lives in the httpOnly cookie.
  tokenHash String    @unique
  family    String    @db.Uuid // rotation family for reuse-detection
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Short-lived email sign-in code (the "verification code" step). After the
/// password is verified a six-digit code is emailed and must be entered to
/// finish signing in — mirrors MICA's login challenge. Only a hash is stored.
model LoginChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  attempts   Int       @default(0)
  rememberMe Boolean   @default(false)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Self-service "forgot password" token delivered as a link. Only a hash of the
/// opaque token is stored; the raw value lives solely in the emailed URL.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Org structure ────────────────────────────────

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  code      String
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  employees   Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("branches")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  branchId  String?   @db.Uuid
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@index([branchId])
  @@map("departments")
}

// ───────────────────────────── Employees ────────────────────────────────────

model Employee {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  employeeNo String
  name       String
  avatarUrl  String?
  status     EmployeeStatus @default(ACTIVE)
  joinedAt   DateTime?

  // Contract & probation tracking (all optional — additive, no data loss)
  contractStartDate DateTime?
  contractMonths    Int? // total contract length in months (e.g. 12/24/36/48)
  probationMonths   Int? // probation length in months (e.g. 3/6/12 or custom)

  // HR master-data fields (populated by the Excel import; all optional/additive)
  nameEn             String?
  email              String?
  nationalId         String?
  nationality        String?
  gender             String?
  jobTitle           String?
  directManager      String? // manager name as imported (free text)
  birthDate          DateTime?
  contractEndDate    DateTime?
  probationStartDate DateTime?
  probationEndDate   DateTime?

  /// When the "probation ending soon" reminder was last emailed to the
  /// evaluator, so the daily job notifies once per employee rather than every
  /// day inside the 90-day window.
  probationReminderSentAt DateTime?

  branchId     String? @db.Uuid
  departmentId String? @db.Uuid
  supervisorId String? @db.Uuid
  evaluatorId  String? @db.Uuid

  // Optional link to a login account (when the employee is also a system user)
  userId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  supervisor User?       @relation("SupervisorOf", fields: [supervisorId], references: [id], onDelete: SetNull)
  evaluator  User?       @relation("EvaluatorOf", fields: [evaluatorId], references: [id], onDelete: SetNull)
  user       User?       @relation("UserProfile", fields: [userId], references: [id], onDelete: SetNull)

  evaluations Evaluation[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId, deletedAt])
  @@index([supervisorId])
  @@index([evaluatorId])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@map("employees")
}

/// Employees added manually by a Reviewer/Evaluator when they aren't in the
/// imported master file. Kept in a SEPARATE table so the company's authoritative
/// employee data (populated only via the Excel import) is never mutated.
model CustomEmployee {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  employeeNo     String?
  name           String
  nameEn         String?
  email          String?
  nationalId     String?
  departmentName String?
  jobTitle       String?
  evaluatorId    String?   @db.Uuid
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluator User?  @relation("CustomEmployeeEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  createdBy User   @relation("CustomEmployeeCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@index([evaluatorId])
  @@map("custom_employees")
}

// ───────────────────────────── Templates & Questions ────────────────────────

model EvaluationTemplate {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  title       String
  description String?
  /// REGULAR vs PROBATION — probation employees are evaluated with PROBATION
  /// templates, everyone else with REGULAR. Separated in lists and reports.
  kind        TemplateKind @default(REGULAR)
  isActive    Boolean      @default(true)
  createdById String       @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  questions   Question[]
  evaluations Evaluation[]

  @@index([tenantId, deletedAt])
  @@index([createdById])
  @@map("evaluation_templates")
}

model Question {
  id         String       @id @default(uuid()) @db.Uuid
  templateId String       @db.Uuid
  type       QuestionType
  label      String
  helpText   String?
  required   Boolean      @default(false)
  order      Int          @default(0)

  // Type-specific config as JSON (options list, min/max, star scale, accepted
  // file types/sizes, weight for scoring, etc.). Validated in the app layer.
  config Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  template EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([templateId, order])
  @@map("questions")
}

// ───────────────────────────── Evaluations & Answers ────────────────────────

model Evaluation {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  templateId  String  @db.Uuid
  employeeId  String  @db.Uuid
  evaluatorId String  @db.Uuid // User who performs the evaluation
  reviewerId  String? @db.Uuid // Supervisor who approves/rejects

  status      EvaluationStatus @default(DRAFT)
  // Aggregate normalized score (0..100) computed on submit from weighted answers.
  score       Float?
  submittedAt DateTime?

  /// «التوصية» — fixed recommendation options the evaluator ticks (increment,
  /// promotion, …). Seen by reviewers/management only; deliberately excluded
  /// from anything the employee receives.
  recommendation String[] @default([])

  // Preliminary review (SUPERVISOR / مراجع): first-stage sign-off.
  prelimReviewerId String?   @db.Uuid
  prelimReviewedAt DateTime?

  // Final review (PRIMARY_REVIEWER / مراجع أساسي): last-stage sign-off. reviewedAt
  // marks the final decision; reviewerId is the final reviewer.
  reviewedAt      DateTime?
  // Reason attached when an evaluation is returned for edit or rejected.
  rejectionReason String?

  // ── Manager↔employee flow ──
  /// When the evaluation was first sent to the employee (magic-link issued).
  sentToEmployeeAt   DateTime?
  /// When the employee last acted (agreed or objected) via the magic-link.
  employeeDecisionAt DateTime?
  /// Set when the manager finally approves — the evaluation is read-only after
  /// this and the employee's magic-link is revoked.
  lockedAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template       EvaluationTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  evaluator      User                    @relation("EvaluationSubmitter", fields: [evaluatorId], references: [id], onDelete: Restrict)
  reviewer       User?                   @relation("EvaluationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  prelimReviewer User?                   @relation("EvaluationPrelimReviewer", fields: [prelimReviewerId], references: [id], onDelete: SetNull)
  answers        Answer[]
  comments       EvaluationComment[]
  tokens         EvaluationAccessToken[]
  revisions      EvaluationRevision[]

  @@index([tenantId, status, deletedAt])
  @@index([employeeId])
  @@index([evaluatorId])
  @@index([reviewerId])
  @@index([prelimReviewerId])
  @@index([templateId])
  @@index([submittedAt])
  @@map("evaluations")
}

/// The manager↔employee (and internal HR) conversation on an evaluation.
/// MANAGER/EMPLOYEE messages are the dialogue (visibleToEmployee=true); HR
/// notes are internal feedback on the manager (visibleToEmployee=false). The
/// full thread is retained for HR/IT/Management oversight.
model EvaluationComment {
  id                String        @id @default(uuid()) @db.Uuid
  evaluationId      String        @db.Uuid
  authorType        CommentAuthor
  /// The User who wrote it (MANAGER/HR). Null for EMPLOYEE (no account).
  authorUserId      String?       @db.Uuid
  authorName        String? // denormalized display name (employee has no user row)
  body              String
  /// Whether the employee can see this comment. HR notes are always false.
  visibleToEmployee Boolean       @default(true)
  createdAt         DateTime      @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, createdAt])
  @@map("evaluation_comments")
}

/// Magic-link token that lets the employee view and respond to their evaluation
/// without an account. Hashed like the password-reset token. Valid 30 days or
/// until the evaluation is approved (whichever first).
model EvaluationAccessToken {
  id           String    @id @default(uuid()) @db.Uuid
  evaluationId String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  consumedAt   DateTime? // last time the employee acted (informational)
  revokedAt    DateTime? // set on approval or when a newer link supersedes it
  createdAt    DateTime  @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@map("evaluation_access_tokens")
}

/// Immutable snapshot of the answers + score each time the manager re-sends an
/// edited evaluation, so HR/IT/Management can see the full history of changes.
model EvaluationRevision {
  id           String   @id @default(uuid()) @db.Uuid
  evaluationId String   @db.Uuid
  /// Sequential version number (1 = first send).
  version      Int
  score        Float?
  /// Snapshot of answers as JSON at this version.
  answers      Json
  /// Who triggered this revision (manager user id) and an optional note.
  createdById  String?  @db.Uuid
  note         String?
  createdAt    DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, version])
  @@index([evaluationId])
  @@map("evaluation_revisions")
}

model Answer {
  id           String @id @default(uuid()) @db.Uuid
  evaluationId String @db.Uuid
  questionId   String @db.Uuid

  // Polymorphic value storage — the relevant column is filled per question type.
  valueNumber Float?
  valueText   String?
  valueBool   Boolean?
  valueDate   DateTime?
  valueJson   Json? // for MULTIPLE_CHOICE selections, file metadata, etc.

  /// Free-text note the evaluator writes beside the answer — the «ملاحظات»
  /// column printed appraisal forms carry next to each criterion. It never
  /// affects the score.
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, questionId])
  @@index([questionId])
  @@map("answers")
}

// ───────────────────────────── Notifications ────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId])
  @@map("notifications")
}

// ───────────────────────────── Audit log ────────────────────────────────────

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String?     @db.Uuid
  actorId   String?     @db.Uuid
  action    AuditAction
  entity    String // e.g. "Employee", "Evaluation"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}
